# Godot AI Agent Desktop IDE Configuration

# Port for local FastAPI inference & agent service
AGENT_PORT=8000

# Base Model identifier (HuggingFace repo or local cache path)
BASE_MODEL_NAME_OR_PATH="Qwen/Qwen2.5-Coder-7B-Instruct"

# Fine-tuned Godot PEFT LoRA adapter directory
LORA_ADAPTER_PATH="/path/to/godot-agent-lora/final_adapter"

# Path to Godot 4 binary (defaults to system auto-detection)
GODOT_BIN="/path/to/godot4"

# Optional remote inference endpoint (if model is served on DGX Spark)
REMOTE_INFERENCE_URL=""
