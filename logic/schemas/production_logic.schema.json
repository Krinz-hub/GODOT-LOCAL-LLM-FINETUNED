{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GodotProductionLogicPlan",
  "type": "object",
  "required": [
    "project_summary",
    "assumptions",
    "requirements",
    "gameplay_loop",
    "architecture",
    "scenes",
    "systems",
    "dependencies",
    "implementation_tasks",
    "acceptance_criteria",
    "risks",
    "verification_plan",
    "failure_analysis",
    "execution_state"
  ],
  "properties": {
    "project_summary": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "functional": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nonfunctional": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gameplay_loop": {
      "type": "array",
      "items": { "type": "string" }
    },
    "architecture": {
      "type": "object",
      "required": ["entry_scene", "folders", "autoloads", "engine_apis_used"],
      "properties": {
        "godot_version": { "type": "string" },
        "entry_scene": { "type": "string" },
        "folders": { "type": "array", "items": { "type": "string" } },
        "autoloads": { "type": ["array", "object"] },
        "communication": { "type": ["string", "object", "array"] },
        "physics_layers": { "type": ["string", "object", "array"] },
        "engine_apis_used": { "type": "array", "items": { "type": "string" } },
        "api_note": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "purpose", "root_type", "hierarchy", "script"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "root_type": { "type": "string" },
          "hierarchy": { "type": ["string", "array", "object"] },
          "script": { "type": ["string", "null"] },
          "resources": { "type": "array" },
          "exported_properties": { "type": ["object", "array"] },
          "signals_emitted": { "type": "array" },
          "signals_received": { "type": "array" },
          "dependencies": { "type": "array" },
          "validation": { "type": ["string", "array"] }
        }
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "script_path", "responsibility", "public_methods_project_defined", "signals", "dependencies"],
        "properties": {
          "name": { "type": "string" },
          "script_path": { "type": "string" },
          "attached_to": { "type": "string" },
          "responsibility": { "type": "string" },
          "variables": { "type": ["object", "array"] },
          "public_methods_project_defined": { "type": "array" },
          "signals": { "type": "array" },
          "dependencies": { "type": "array" },
          "state_transitions": { "type": ["array", "string"] },
          "error_handling": { "type": "string" },
          "integration": { "type": "string" },
          "test_cases": { "type": "array" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "depends_on", "reason"],
        "properties": {
          "component": { "type": "string" },
          "depends_on": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "implementation_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "files",
          "prerequisites",
          "expected_output",
          "completion_conditions",
          "verification",
          "recovery"
        ],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "expected_output": { "type": "string" },
          "completion_conditions": { "type": "string" },
          "verification": { "type": "string" },
          "recovery": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "criterion", "verified_by_task"],
        "properties": {
          "id": { "type": "string" },
          "criterion": { "type": "string" },
          "verified_by_task": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array"
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "method", "pass_condition"],
        "properties": {
          "step": { "type": ["string", "integer"] },
          "method": { "type": "string" },
          "pass_condition": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "failure_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observed_error",
          "affected_component",
          "likely_cause",
          "cause_status",
          "diagnostic_steps",
          "proposed_repair",
          "verification_test",
          "expected_result_if_repaired"
        ],
        "properties": {
          "observed_error": { "type": "string" },
          "affected_component": { "type": "string" },
          "likely_cause": { "type": "string" },
          "cause_status": { "type": "string" },
          "diagnostic_steps": { "type": "string" },
          "proposed_repair": { "type": "string" },
          "verification_test": { "type": "string" },
          "expected_result_if_repaired": { "type": "string" },
          "repair_status": { "type": "string" }
        }
      }
    },
    "execution_state": {
      "type": "string"
    }
  }
}
